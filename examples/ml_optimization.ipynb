        "ax2.set_aspect('equal')\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "print(\"\\n📊 Visualization Explanation:\")\n",
        "print(\"  Left plot: Shows convergence quality improving from -1.0 (diverging) to +1.0 (converging)\")\n",
        "print(\"  Right plot: Red arrows = initial wrong directions (pointing away)\")\n",
        "print(\"              Green arrows = corrected directions (pointing toward focal point)\")"
      ]
    },
    {
      "cell_type": "markdown",
