        "ax1.axhspan(CONVERGENCE_OPTIMAL, 1.1, alpha=0.1, color='green')\n",
        "ax1.axhspan(CONVERGENCE_CRITICAL, CONVERGENCE_WARNING, alpha=0.1, color='orange')\n",
        "ax1.axhspan(-1.1, CONVERGENCE_CRITICAL, alpha=0.1, color='red')\n",
        "\n",
        "ax1.set_xlabel('Optimization Step', fontsize=12)\n",
        "ax1.set_ylabel('Convergence Quality', fontsize=12)\n",
        "ax1.set_title('MADA Convergence Optimization Progress', fontsize=14, fontweight='bold')\n",
        "ax1.set_ylim([-1.1, 1.1])\n",
        "ax1.legend(fontsize=10)\n",
        "ax1.grid(True, alpha=0.3)\n",
        "\n",
        "# Right plot: 2D vector field directions (XY plane)\n",
        "# Show initial, intermediate, and final configurations\n",
        "ax2.quiver(mada1_pos[0], mada1_pos[1], \n",
        "           B1_dir_history[0][0], B1_dir_history[0][1],\n",
        "           color='red', scale=3, width=0.01, label='Initial (WRONG)', alpha=0.5)\n",
        "ax2.quiver(mada2_pos[0], mada2_pos[1],\n",
        "           B2_dir_history[0][0], B2_dir_history[0][1],\n",
        "           color='red', scale=3, width=0.01, alpha=0.5)\n",
        "\n",
        "ax2.quiver(mada1_pos[0], mada1_pos[1],\n",
        "           B1_dir_history[-1][0], B1_dir_history[-1][1],\n",
        "           color='green', scale=3, width=0.01, label='Final (CORRECT)', alpha=1.0)\n",
        "ax2.quiver(mada2_pos[0], mada2_pos[1],\n",
        "           B2_dir_history[-1][0], B2_dir_history[-1][1],\n",
        "           color='green', scale=3, width=0.01, alpha=1.0)\n",
        "\n",
        "# Mark positions\n",
        "ax2.scatter(mada1_pos[0], mada1_pos[1], s=200, c='blue', marker='o', label='MADA 1', zorder=5)\n",
        "ax2.scatter(mada2_pos[0], mada2_pos[1], s=200, c='orange', marker='o', label='MADA 2', zorder=5)\n",
        "ax2.scatter(center[0], center[1], s=300, c='gold', marker='*', label='Focal Point', zorder=10)\n",
        "\n",
        "ax2.set_xlabel('X Position (m)', fontsize=12)\n",
        "ax2.set_ylabel('Y Position (m)', fontsize=12)\n",
        "ax2.set_title('Field Direction Correction (Top View)', fontsize=14, fontweight='bold')\n",
        "ax2.set_xlim([-0.5, 0.5])\n",
        "ax2.set_ylim([-0.3, 0.3])\n",
        "ax2.legend(fontsize=10)\n",
