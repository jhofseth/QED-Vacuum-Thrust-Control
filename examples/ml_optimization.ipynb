      "source": [
        "## Part 3: Predictive Maintenance Model with MADA Convergence\n",
        "\n",
        "Train the MaintenanceNN to predict material degradation and adapt pulsing frequency.\n",
        "\n",
        "**NEW**: Convergence quality is now included as a critical input feature!\n",
        "\n",
        "Inputs: cycles, temp, B_field, threat_level, **convergence_quality**\n",
        "Outputs: degradation_prob, adapted_frequency\n",
        "\n",
        "Poor convergence quality should strongly correlate with higher degradation risk."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Generate synthetic data with convergence quality\n",
        "num_samples = 1000\n",
        "cycles = np.random.randint(1, 10000, num_samples)\n",
        "temp = np.random.uniform(20, 120, num_samples)\n",
        "B_field = np.random.uniform(20, 60, num_samples)\n",
        "threat_level = np.random.uniform(0, 1, num_samples)\n",
        "\n",
        "# NEW: Generate convergence quality data\n",
        "# Most samples have good convergence, some have degraded quality\n",
        "convergence_quality = np.random.beta(8, 2, num_samples)  # Skewed toward high values\n",
        "# Inject some poor convergence samples\n",
        "poor_conv_indices = np.random.choice(num_samples, size=int(0.1 * num_samples), replace=False)\n",
        "convergence_quality[poor_conv_indices] = np.random.uniform(0.5, 0.8, len(poor_conv_indices))\n",
        "\n",
        "# Synthetic targets with convergence quality influence\n",
        "# Degradation increases with: high cycles, high temp, LOW convergence quality\n",
        "base_degradation = 1 / (1 + np.exp(-0.001 * (cycles + 10 * (temp - 50))))\n",
        "convergence_penalty = (1 - convergence_quality) * 0.5  # Max 50% additional degradation\n",
        "degradation = np.clip(base_degradation + convergence_penalty, 0, 1)\n",
        "\n",
        "# Adapted frequency decreases with degradation and poor convergence\n",
        "adapted_freq = 100 * (1 - degradation) * convergence_quality + 50 * np.random.uniform(-0.1, 0.1, num_samples)\n",
        "adapted_freq = np.clip(adapted_freq, 20, 150)  # Realistic frequency range\n",
        "\n",
        "# Stack features (NOW WITH 5 inputs instead of 4)\n",
        "X = np.column_stack([cycles, temp, B_field, threat_level, convergence_quality])\n",
        "y = np.column_stack([degradation, adapted_freq])\n",
        "\n",
        "# Split data\n",
        "split = int(0.8 * num_samples)\n",
        "X_train, X_test = X[:split], X[split:]\n",
        "y_train, y_test = y[:split], y[split:]\n",
        "\n",
        "print(f\"Training samples: {len(X_train)}\")\n",
        "print(f\"Test samples: {len(X_test)}\")\n",
        "print(f\"Features: {X.shape[1]} (cycles, temp, B_field, threat_level, convergence_quality)\")\n",
        "print(f\"Targets: {y.shape[1]} (degradation_prob, adapted_frequency)\")\n",
        "print(f\"\\nConvergence quality statistics:\")\n",
        "print(f\"  Mean: {np.mean(convergence_quality):.3f}\")\n",
        "print(f\"  Std: {np.std(convergence_quality):.3f}\")\n",
        "print(f\"  Min: {np.min(convergence_quality):.3f}\")\n",
        "print(f\"  Samples with quality < 0.85: {np.sum(convergence_quality < CONVERGENCE_WARNING)} ({np.sum(convergence_quality < CONVERGENCE_WARNING)/num_samples*100:.1f}%)\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Build model with updated input size\n",
        "model = Sequential([\n",
        "    Dense(64, activation='relu', input_shape=(5,)),  # NOW 5 inputs!\n",
        "    Dense(32, activation='relu'),n",
        "    Dense(16, activation='relu'),\n",
        "    Dense(2)  # 2 outputs: degradation, frequency\n",
        "])\n",
        "\n",
        "model.compile(optimizer='adam', loss='mse', metrics=['mae'])\n",
        "\n",
        "print(\"Model architecture:\")\n",
        "model.summary()\n",
        "\n",
        "# Train\n",
        "print(\"\\nTraining...\")\n",
        "history = model.fit(X_train, y_train, \n",
        "                    epochs=50, \n",
        "                    batch_size=32, \n",
        "                    validation_split=0.2, \n",
        "                    verbose=0)\n",
        "\n",
        "# Evaluate\n",
        "test_loss, test_mae = model.evaluate(X_test, y_test, verbose=0)\n",
        "print(f'\\nTest Loss: {test_loss:.4f}, Test MAE: {test_mae:.4f}')\n",
        "\n",
        "# Plot training history\n",
        "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5))\n",
        "\n",
        "ax1.plot(history.history['loss'], label='Train Loss')\n",
        "ax1.plot(history.history['val_loss'], label='Val Loss')\n",
        "ax1.set_title('Training History - Loss')\n",
        "ax1.set_xlabel('Epoch')\n",
        "ax1.set_ylabel('MSE Loss')\n",
        "ax1.legend()\n",
        "ax1.grid(True, alpha=0.3)\n",
        "\n",
        "ax2.plot(history.history['mae'], label='Train MAE')\n",
        "ax2.plot(history.history['val_mae'], label='Val MAE')\n",
        "ax2.set_title('Training History - MAE')\n",
        "ax2.set_xlabel('Epoch')\n",
        "ax2.set_ylabel('Mean Absolute Error')\n",
        "ax2.legend()\n",
        "ax2.grid(True, alpha=0.3)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Interactive Prediction with Convergence Quality\n",
        "\n",
        "Use the trained model to predict for custom inputs.\n",
        "**Notice how poor convergence quality dramatically affects predictions!**"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Test scenarios\n",
        "scenarios = [\n",
        "    {\n",
        "        'name': 'Optimal Operation',\n",
        "        'input': [5000, 60.0, 50.0, 0.3, 0.98],  # Good convergence\n",
        "        'description': 'Normal operation with excellent MADA convergence'\n",
        "    },\n",
        "    {\n",
        "        'name': 'High Temperature',\n",
        "        'input': [5000, 95.0, 50.0, 0.3, 0.95],  # High temp but good convergence\n",
        "        'description': 'High thermal stress but MADA alignment is good'\n",
        "    },\n",
        "    {\n",
        "        'name': 'Poor Convergence',\n",
        "        'input': [5000, 60.0, 50.0, 0.3, 0.75],  # BAD convergence!\n",
        "        'description': 'WARNING: MADA fields not properly aligned!'\n",
        "    },\n",
        "    {\n",
        "        'name': 'Critical Failure',\n",
        "        'input': [8000, 100.0, 55.0, 0.8, 0.60],  # Everything bad\n",
        "        'description': 'CRITICAL: High stress + poor MADA convergence!'\n",
        "    }\n",
        "]\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"PREDICTIVE MAINTENANCE SCENARIOS\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "results = []\n",
        "for scenario in scenarios:\n",
        "    input_data = np.array([scenario['input']])\n",
        "    prediction = model.predict(input_data, verbose=0)\n",
        "    deg_prob, adapt_freq = prediction[0]\n",
        "    \n",
