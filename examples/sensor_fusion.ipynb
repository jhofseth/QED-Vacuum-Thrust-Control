    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## NEW: Convergence Statistics and Diagnostics\n",
        "\n",
        "Detailed analysis of MADA convergence performance during the simulation."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "print(\"=\" * 60)\n",
        "print(\"MADA CONVERGENCE DIAGNOSTIC REPORT\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "# Overall statistics\n",
        "print(f\"\\nOverall Statistics:\")\n",
        "print(f\"  Total simulation time: {NUM_STEPS * DT:.1f} seconds\")\n",
        "print(f\"  Mean convergence quality: {np.mean(convergence_history):.4f}\")\n",
        "print(f\"  Std deviation: {np.std(convergence_history):.4f}\")\n",
        "print(f\"  Minimum quality: {np.min(convergence_history):.4f} (at t={np.argmin(convergence_history) * DT:.1f}s)\")\n",
        "print(f\"  Maximum quality: {np.max(convergence_history):.4f} (at t={np.argmax(convergence_history) * DT:.1f}s)\")\n",
        "\n",
        "# Time in each zone\n",
        "optimal_steps = np.sum(convergence_history >= CONVERGENCE_OPTIMAL)\n",
        "acceptable_steps = np.sum((convergence_history >= CONVERGENCE_WARNING) & (convergence_history < CONVERGENCE_OPTIMAL))\n",
        "warning_steps = np.sum((convergence_history >= CONVERGENCE_CRITICAL) & (convergence_history < CONVERGENCE_WARNING))\n",
        "critical_steps = np.sum(convergence_history < CONVERGENCE_CRITICAL)\n",
        "\n",
        "print(f\"\\nTime Distribution:\")\n",
