{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# QED Vacuum Propulsion - Multi-Drone Swarm Simulation\n",
        "\n",
        "Interactive demonstration of multi-drone swarm simulations using PyBullet physics engine.\n",
        "\n",
        "## Features\n",
        "\n",
        "- **Physics-based simulation**: PyBullet 3D rigid body dynamics\n",
        "- **QED thrust integration**: Real thrust calculations from `simulations/thrust_model.py`\n",
        "- **Swarm behaviors**: Formation flight, asymmetric warfare scenarios\n",
        "- **3D visualization**: Trajectory plotting and real-time physics\n",
        "- **Scalable**: From 5 to 50+ drones\n",
        "\n",
        "## Requirements\n",
        "\n",
        "```bash\n",
        "pip install pybullet numpy matplotlib\n",
        "```\n",
        "\n",
        "## Usage\n",
        "\n",
        "Run cells sequentially (Shift+Enter). Adjust parameters in configuration cells.\n",
        "\n",
        "---"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 1. Import Dependencies"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import sys\n",
        "import os\n",
        "import numpy as np\n",
        "import time\n",
        "import matplotlib.pyplot as plt\n",
        "from mpl_toolkits.mplot3d import Axes3D\n",
        "from IPython.display import clear_output\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "# PyBullet\n",
        "try:\n",
        "    import pybullet as p\n",
        "    import pybullet_data\n",
        "    PYBULLET_AVAILABLE = True\n",
        "    print(\"✓ PyBullet loaded successfully\")\n",
        "except ImportError:\n",
        "    PYBULLET_AVAILABLE = False\n",
        "    print(\"✗ PyBullet not available. Install with: pip install pybullet\")\n",
        "    raise\n",
        "\n",
        "# Add parent directory to path\n",
        "notebook_dir = os.getcwd()\n",
        "parent_dir = os.path.dirname(notebook_dir)\n",
        "if parent_dir not in sys.path:\n",
        "    sys.path.insert(0, parent_dir)\n",
        "\n",
        "# Import project modules\n",
        "try:\n",
        "    from simulations.thrust_model import calculate_thrust_params\n",
        "    from simulations.equations import force_vector, total_thrust, acceleration\n",
        "    print(\"✓ QED modules loaded successfully\")\n",
        "except ImportError as e:\n",
        "    print(f\"✗ Failed to import QED modules: {e}\")\n",
        "    print(\"  Make sure you're running from the project root or examples/ directory\")\n",
        "    raise\n",
        "\n",
        "print(\"\\n\" + \"=\"*60)\n",
        "print(\"QED VACUUM PROPULSION - SWARM SIMULATION\")\n",
        "print(\"=\"*60)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 2. Configuration\n",
        "\n",
        "Adjust simulation parameters here:"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Simulation parameters\n",
        "NUM_DRONES = 10  # Number of drones in swarm\n",
        "DRONE_MASS = 20000.0  # kg (from thrust_model.py defaults)\n",
        "SIM_TIME = 30.0  # Simulation duration (seconds)\n",
        "TIME_STEP = 1/240  # Physics timestep (Hz)\n",
        "REAL_TIME = True  # Run in real-time (False = faster)\n",
        "GUI_MODE = True  # Show PyBullet GUI (False = headless)\n",
        "\n",
        "# Scenario selection\n",
        "SCENARIO = 'asymmetric'  # Options: 'asymmetric', 'symmetric', 'formation'\n",
        "\n",
        "# Thrust parameters (from QED model)\n",
        "B_OPPOSING = 50.0  # Tesla\n",
        "FREQUENCY = 100.0  # Hz\n",
        "N_UNITS = 24  # MADA units\n",
        "CURRENT = 15.0  # Amperes\n",
        "\n",
        "# Visualization\n",
        "RECORD_INTERVAL = 10  # Record position every N steps\n",
        "\n",
        "print(f\"Configuration:\")\n",
        "print(f\"  Drones: {NUM_DRONES}\")\n",
        "print(f\"  Scenario: {SCENARIO}\")\n",
        "print(f\"  Duration: {SIM_TIME}s\")\n",
        "print(f\"  B-field: {B_OPPOSING}T\")\n",
        "print(f\"  Frequency: {FREQUENCY}Hz\")\n",
        "print(f\"  GUI: {'Enabled' if GUI_MODE else 'Disabled'}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 3. Initialize PyBullet Physics Engine"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Connect to PyBullet\n",
        "if GUI_MODE:\n",
        "    physicsClient = p.connect(p.GUI)\n",
        "    print(\"PyBullet GUI started (close window when done)\")\n",
        "else:\n",
        "    physicsClient = p.connect(p.DIRECT)\n",
        "    print(\"PyBullet running in headless mode\")\n",
        "\n",
        "# Configure physics\n",
        "p.setAdditionalSearchPath(pybullet_data.getDataPath())\n",
        "p.setGravity(0, 0, -9.81)\n",
        "p.setTimeStep(TIME_STEP)\n",
        "p.setRealTimeSimulation(0)  # Manual stepping for control\n",
        "\n",
        "# Load environment\n",
        "planeId = p.loadURDF(\"plane.urdf\")\n",
        "print(f\"✓ Physics engine initialized (timestep: {TIME_STEP*1000:.2f}ms)\")\n",
        "\n",
        "# Camera setup (if GUI)\n",
        "if GUI_MODE:\n",
        "    p.resetDebugVisualizerCamera(\n",
        "        cameraDistance=20,\n",
        "        cameraYaw=45,\n",
        "        cameraPitch=-30,\n",
        "        cameraTargetPosition=[0, 0, 5]\n",
        "    )\n",
        "    print(\"✓ Camera configured\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 4. Calculate Thrust for Each Drone\n",
        "\n",
        "Use QED thrust model to compute forces:"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Create mock arguments object for thrust calculation\n",
        "class Args:\n",
        "    def __init__(self):\n",
        "        self.frequency = FREQUENCY\n",
        "        self.mass = DRONE_MASS\n",
        "        self.n_units = N_UNITS\n",
        "        self.current = CURRENT\n",
        "        self.b_opposing = B_OPPOSING\n",
        "        self.m1 = 100.0\n",
        "        self.m2 = 100.0\n",
        "        self.distance = 0.05\n",
        "\n",
        "args = Args()\n",
        "\n",
        "# Calculate base thrust\n",
        "T_base, a_base, P_base, eta, R, B_total = calculate_thrust_params(args, verbose=False)\n",
        "\n",
        "print(f\"\\nBase Thrust Calculations:\")\n",
        "print(f\"  Thrust: {T_base:.0f} N ({T_base/1000:.1f} kN)\")\n",
        "print(f\"  Acceleration: {a_base:.2f} m/s² ({a_base/9.81:.2f}g)\")\n",
        "print(f\"  Power: {P_base:.0f} W ({P_base/1000:.1f} kW)\")\n",
        "print(f\"  Efficiency: {eta:.1f}%\")\n",
        "print(f\"  B-field (total): {B_total:.2f} T\")\n",
        "\n",
        "# Assign thrusts based on scenario\n",
        "drone_thrusts = []\n",
        "drone_colors = []\n",
        "\n",
        "if SCENARIO == 'asymmetric':\n",
        "    # Advanced drones (50%) vs Standard drones (50%)\n",
        "    for i in range(NUM_DRONES):\n",
        "        if i < NUM_DRONES // 2:\n",
        "            thrust = T_base * 1.5  # Advanced: 150% thrust\n",
        "            color = [0.8, 0.2, 0.2, 1.0]  # Red\n",
        "        else:\n",
        "            thrust = T_base * 0.5  # Standard: 50% thrust\n",
        "            color = [0.2, 0.2, 0.8, 1.0]  # Blue\n",
        "        drone_thrusts.append(thrust)\n",
        "        drone_colors.append(color)\n",
        "    print(f\"\\nAsymmetric scenario: {NUM_DRONES//2} advanced vs {NUM_DRONES - NUM_DRONES//2} standard\")\n",
        "\n",
        "elif SCENARIO == 'symmetric':\n",
        "    # All drones equal thrust\n",
        "    for i in range(NUM_DRONES):\n",
        "        drone_thrusts.append(T_base)\n",
        "        drone_colors.append([0.2, 0.8, 0.2, 1.0])  # Green\n",
        "    print(f\"\\nSymmetric scenario: All {NUM_DRONES} drones equal thrust\")\n",
        "\n",
        "elif SCENARIO == 'formation':\n",
        "    # Leader + followers\n",
        "    for i in range(NUM_DRONES):\n",
        "        if i == 0:\n",
        "            thrust = T_base * 2.0  # Leader: 200% thrust\n",
        "            color = [0.9, 0.9, 0.0, 1.0]  # Yellow\n",
        "        else:\n",
        "            thrust = T_base  # Followers: 100% thrust\n",
        "            color = [0.2, 0.8, 0.2, 1.0]  # Green\n",
        "        drone_thrusts.append(thrust)\n",
        "        drone_colors.append(color)\n",
        "    print(f\"\\nFormation scenario: 1 leader + {NUM_DRONES-1} followers\")\n",
        "\n",
        "print(f\"Thrust range: {min(drone_thrusts):.0f} - {max(drone_thrusts):.0f} N\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 5. Spawn Drones in Formation"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Drone IDs and tracking\n",
        "drone_ids = []\n",
        "trajectories = [[] for _ in range(NUM_DRONES)]\n",
        "start_positions = []\n",
        "\n",
        "# Spawn formation\n",
        "if SCENARIO == 'formation':\n",
        "    # V-formation\n",
        "    for i in range(NUM_DRONES):\n",
        "        x = 0 if i == 0 else (i - 1) * 2 * (1 if (i-1) % 2 == 0 else -1)\n",
        "        y = 0 if i == 0 else -(i // 2) * 2\n",
        "        z = 2.0\n",
        "        start_positions.append([x, y, z])\n",
        "else:\n",
        "    # Line formation\n",
        "    for i in range(NUM_DRONES):\n",
        "        x = (i - NUM_DRONES / 2) * 3.0\n",
        "        y = 0.0\n",
        "        z = 2.0\n",
        "        start_positions.append([x, y, z])\n",
        "\n",
        "# Load drones\n",
        "for i, pos in enumerate(start_positions):\n",
        "    # Load sphere URDF as drone proxy\n",
        "    drone_id = p.loadURDF(\n",
        "        \"sphere2.urdf\",\n",
        "        pos,\n",
        "        globalScaling=0.5  # 0.5m radius sphere\n",
        "    )\n",
        "    \n",
        "    # Set physics properties\n",
        "    p.changeDynamics(\n",
        "        drone_id,\n",
        "        -1,\n",
        "        mass=DRONE_MASS,\n",
        "        linearDamping=0.1,\n",
        "        angularDamping=0.1\n",
        "    )\n",
        "    \n",
        "    # Set visual appearance\n",
        "    p.changeVisualShape(\n",
        "        drone_id,\n",
        "        -1,\n",
        "        rgbaColor=drone_colors[i]\n",
        "    )\n",
        "    \n",
        "    drone_ids.append(drone_id)\n",
        "    trajectories[i].append(np.array(pos))\n",
        "\n",
        "print(f\"✓ Spawned {NUM_DRONES} drones in {SCENARIO} formation\")\n",
        "print(f\"  Mass per drone: {DRONE_MASS} kg\")\n",
        "print(f\"  Formation spread: {max([p[0] for p in start_positions]) - min([p[0] for p in start_positions]):.1f} m\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 6. Run Physics Simulation\n",
        "\n",
        "Main simulation loop with thrust application and event handling:"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "print(f\"\\nStarting simulation: {SIM_TIME}s ({int(SIM_TIME/TIME_STEP)} steps)\\n\")\n",
        "\n",
        "# Simulation loop\n",
        "total_steps = int(SIM_TIME / TIME_STEP)\n",
        "record_counter = 0\n",
        "attack_count = 0\n",
        "\n",
        "start_time = time.time()\n",
        "\n",
        "for step in range(total_steps):\n",
        "    # Apply thrust to each drone\n",
        "    for i, drone_id in enumerate(drone_ids):\n",
        "        thrust = drone_thrusts[i]\n",
        "        \n",
        "        # Apply vertical thrust (simplified - could add vectoring)\n",
        "        thrust_vec = [0, 0, thrust]\n",
        "        p.applyExternalForce(\n",
        "            drone_id,\n",
        "            -1,\n",
        "            thrust_vec,\n",
        "            [0, 0, 0],\n",
        "            p.LINK_FRAME\n",
        "        )\n",
        "        \n",
        "        # Add small random perturbations (turbulence)\n",
        "        if step % 50 == 0:\n",
        "            perturb = np.random.normal(0, 100, 3)\n",
        "            p.applyExternalForce(\n",
        "                drone_id,\n",
        "                -1,\n",
        "                perturb.tolist(),\n",
        "                [0, 0, 0],\n",
        "                p.WORLD_FRAME\n",
        "            )\n",
        "        \n",
        "        # Record position\n",
        "        if record_counter % RECORD_INTERVAL == 0:\n",
        "            pos, _ = p.getBasePositionAndOrientation(drone_id)\n",
        "            trajectories[i].append(np.array(pos))\n",
        "    \n",
        "    # Asymmetric warfare events\n",
        "    if SCENARIO == 'asymmetric' and np.random.rand() < 0.002:  # 0.2% chance\n",
        "        # Advanced drones \"attack\" standard drones\n",
        "        target_idx = np.random.choice(range(NUM_DRONES // 2, NUM_DRONES))\n",
        "        attack_force = [0, 0, -50000]  # Strong downward force\n",
        "        p.applyExternalForce(\n",
        "            drone_ids[target_idx],\n",
        "            -1,\n",
        "            attack_force,\n",
        "            [0, 0, 0],\n",
        "            p.LINK_FRAME\n",
        "        )\n",
        "        attack_count += 1\n",
        "    \n",
        "    # Step simulation\n",
        "    p.stepSimulation()\n",
        "    record_counter += 1\n",
        "    \n",
        "    # Real-time sleep\n",
        "    if REAL_TIME:\n",
        "        time.sleep(TIME_STEP)\n",
        "    \n",
        "    # Progress update\n",
        "    if step % (total_steps // 10) == 0:\n",
        "        sim_time = step * TIME_STEP\n",
        "        progress = (step / total_steps) * 100\n",
        "        print(f\"  Progress: {progress:.0f}% (t={sim_time:.1f}s)\")\n",
        "\n",
        "elapsed_time = time.time() - start_time\n",
        "\n",
        "print(f\"\\n✓ Simulation complete\")\n",
        "print(f\"  Real time: {elapsed_time:.2f}s\")\n",
        "print(f\"  Simulation time: {SIM_TIME:.2f}s\")\n",
        "print(f\"  Speed: {SIM_TIME/elapsed_time:.1f}x real-time\")\n",
        "if SCENARIO == 'asymmetric':\n",
        "    print(f\"  Attack events: {attack_count}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 7. Get Final Statistics"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Collect final positions and statistics\n",
        "final_positions = []\n",
        "final_velocities = []\n",
        "distances_traveled = []\n",
        "\n",
        "for i, drone_id in enumerate(drone_ids):\n",
        "    pos, _ = p.getBasePositionAndOrientation(drone_id)\n",
        "    vel, _ = p.getBaseVelocity(drone_id)\n",
        "    final_positions.append(pos)\n",
        "    final_velocities.append(vel)\n",
        "    \n",
        "    # Calculate distance traveled\n",
        "    traj = np.array(trajectories[i])\n",
        "    if len(traj) > 1:\n",
        "        dist = np.sum(np.linalg.norm(np.diff(traj, axis=0), axis=1))\n",
        "        distances_traveled.append(dist)\n",
        "\n",
        "print(f\"\\nFinal Statistics:\")\n",
        "print(f\"  Average altitude: {np.mean([p[2] for p in final_positions]):.2f} m\")\n",
        "print(f\"  Average speed: {np.mean([np.linalg.norm(v) for v in final_velocities]):.2f} m/s\")\n",
        "if distances_traveled:\n",
        "    print(f\"  Average distance: {np.mean(distances_traveled):.2f} m\")\n",
        "print(f\"  Swarm spread: {np.std([p[0] for p in final_positions]):.2f} m (X-axis)\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 8. Disconnect PyBullet"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Clean up\n",
        "p.disconnect()\n",
        "print(\"✓ PyBullet disconnected\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 9. Visualize 3D Trajectories"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Create 3D trajectory plot\n",
        "fig = plt.figure(figsize=(14, 10))\n",
        "ax = fig.add_subplot(111, projection='3d')\n",
        "\n",
        "# Plot each drone's trajectory\n",
        "for i, traj in enumerate(trajectories):\n",
        "    traj_array = np.array(traj)\n",
        "    if len(traj_array) > 1:\n",
        "        color = drone_colors[i][:3]  # RGB only\n",
        "        label = f'Drone {i+1}'\n",
        "        if SCENARIO == 'asymmetric':\n",
        "            label += ' (Adv)' if i < NUM_DRONES // 2 else ' (Std)'\n",
        "        elif SCENARIO == 'formation':\n",
        "            label += ' (Leader)' if i == 0 else ' (Follower)'\n",
        "        \n",
        "        ax.plot(\n",
        "            traj_array[:, 0],\n",
        "            traj_array[:, 1],\n",
        "            traj_array[:, 2],\n",
        "            color=color,\n",
        "            label=label,\n",
        "            linewidth=2,\n",
        "            alpha=0.7\n",
        "        )\n",
        "        \n",
        "        # Mark start and end\n",
        "        ax.scatter(\n",
        "            traj_array[0, 0],\n",
        "            traj_array[0, 1],\n",
        "            traj_array[0, 2],\n",
        "            color=color,\n",
        "            marker='o',\n",
        "            s=100,\n",
        "            edgecolors='k'\n",
        "        )\n",
        "        ax.scatter(\n",
        "            traj_array[-1, 0],\n",
        "            traj_array[-1, 1],\n",
        "            traj_array[-1, 2],\n",
        "            color=color,\n",
        "            marker='s',\n",
        "            s=100,\n",
        "            edgecolors='k'\n",
        "        )\n",
        "\n",
        "ax.set_xlabel('X Position (m)', fontsize=12)\n",
        "ax.set_ylabel('Y Position (m)', fontsize=12)\n",
        "ax.set_zlabel('Z Position (m)', fontsize=12)\n",
        "ax.set_title(\n",
        "    f'QED Swarm Simulation - {SCENARIO.capitalize()} Scenario ({NUM_DRONES} Drones)',\n",
        "    fontsize=14,\n",
        "    fontweight='bold'\n",
        ")\n",
        "ax.legend(loc='upper left', fontsize=8)\n",
        "ax.grid(True, alpha=0.3)\n",
        "\n",
        "# Set equal aspect ratio\n",
        "max_range = np.array([\n",
        "    max([max(t[:, 0]) for t in [np.array(tr) for tr in trajectories if len(tr) > 0]]),\n",
        "    max([max(t[:, 1]) for t in [np.array(tr) for tr in trajectories if len(tr) > 0]]),\n",
        "    max([max(t[:, 2]) for t in [np.array(tr) for tr in trajectories if len(tr) > 0]])\n",
        "]).max()\n",
        "ax.set_xlim([-max_range, max_range])\n",
        "ax.set_ylim([-max_range, max_range])\n",
        "ax.set_zlim([0, max_range * 2])\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "print(\"✓ Trajectory visualization complete\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 10. Statistical Analysis"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Create statistical plots\n",
        "fig, axes = plt.subplots(2, 2, figsize=(14, 10))\n",
        "\n",
        "# 1. Altitude over time\n",
        "ax1 = axes[0, 0]\n",
        "for i, traj in enumerate(trajectories):\n",
        "    if len(traj) > 1:\n",
        "        traj_array = np.array(traj)\n",
        "        times = np.arange(len(traj)) * RECORD_INTERVAL * TIME_STEP\n",
        "        ax1.plot(times, traj_array[:, 2], color=drone_colors[i][:3], alpha=0.7)\n",
        "ax1.set_xlabel('Time (s)')\n",
        "ax1.set_ylabel('Altitude (m)')\n",
        "ax1.set_title('Altitude vs Time')\n",
        "ax1.grid(True, alpha=0.3)\n",
        "\n",
        "# 2. Speed over time\n",
        "ax2 = axes[0, 1]\n",
        "for i, traj in enumerate(trajectories):\n",
        "    if len(traj) > 1:\n",
        "        traj_array = np.array(traj)\n",
        "        if len(traj_array) > 1:\n",
        "            velocities = np.diff(traj_array, axis=0) / (RECORD_INTERVAL * TIME_STEP)\n",
        "            speeds = np.linalg.norm(velocities, axis=1)\n",
        "            times = np.arange(len(speeds)) * RECORD_INTERVAL * TIME_STEP\n",
